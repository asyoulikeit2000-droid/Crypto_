{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm install --omit=dev && npm run check:migration && npm test"
  },
  "deploy": {
    "startCommand": "node binance-shadow-worker.mjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
